{
  "name": "khapiman",
  "version": "1.0.0",
  "description": "KHapiMAN is a full-screen API profile manager for AI coding CLIs.",
  "type": "module",
  "bin": {
    "khapiman": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lockfile": "node scripts/check-lockfile-hosts.mjs",
    "check:package-brand": "node scripts/check-package-brand.mjs",
    "check": "npm run check:lockfile && npm run typecheck && npm run lint && npm test && npm run build && npm run check:package-brand",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "aider",
    "llm",
    "relay",
    "tui",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noviantia/KHapiMAN.git"
  },
  "homepage": "https://github.com/noviantia/KHapiMAN#readme",
  "bugs": {
    "url": "https://github.com/noviantia/KHapiMAN/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.8",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
